# Salin jadi .env.local lalu sesuaikan.
# Backend RAG berjalan sepenuhnya lokal — tanpa Langflow, tanpa API key.

# Ollama (server model). Default di bawah sudah benar untuk setup lokal.
OLLAMA_URL=http://localhost:11434

# Model IBM Granite yang dijalankan lewat Ollama.
#   granite3.3:8b — kualitas terbaik; lolos seluruh 20 soal eval (CPU: ±2–4 menit/jawaban)
#   granite3.3:2b — jauh lebih cepat (±40–70 detik); cocok untuk demo live
OLLAMA_MODEL=granite3.3:8b

# Opsional
# LLM_TEMPERATURE=0.2      # rendah = lebih patuh pada konteks (anti-halusinasi)
# LLM_TIMEOUT_MS=600000    # batas tunggu per jawaban (ms)
# KNOWLEDGE_DIR=../knowledge-base   # override lokasi korpus dokumen

# ---- Gemini (API Google) ----
# Untuk memakai Gemini: isi GEMINI_API_KEY, lalu ganti LLM_PROVIDER=gemini.
# GEMINI_API_KEY=isi-kunci-mu-disini
# GEMINI_MODEL=gemini-3.1-flash-lite

# ---- Metadata toko (muncul di UI & jadi sumber kebenaran Rara) ----
STORE_NAME=Batik Larasati Pekalongan
STORE_TAGLINE=Batik tulis & cap khas pesisir Pekalongan, ditulis tangan oleh pengrajin setempat
STORE_SINCE=2015
ADMIN_WHATSAPP=+6287872566458
ADMIN_NAME=Rara
DISCLAIMER_AI=Bot AI layanan pelanggan
