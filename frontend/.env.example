# Salin jadi .env.local lalu sesuaikan.
# URL Langflow lokal (default sudah benar untuk setup ini)
LANGFLOW_URL=http://localhost:7860

# ID atau nama flow. Ambil dari URL browser saat flow dibuka di Langflow,
# atau klik ikon "API" di pojok flow → salin cURL.
LANGFLOW_FLOW_ID=UMKM%20Assistant

# Opsional: kalau flow diaktifkan proteksinya di Langflow
# LANGFLOW_API_KEY=
